"""Bazel build for the unitree_rl_mjlab deploy controllers."""

module(name = "unitree_rl_deploy")

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

bazel_dep(name = "boost.program_options", version = "1.87.0")
bazel_dep(name = "yaml-cpp", version = "0.8.0")
bazel_dep(name = "fmt", version = "11.2.0")
bazel_dep(name = "spdlog", version = "1.15.3")
bazel_dep(name = "eigen", version = "3.4.0.bcr.3")
bazel_dep(name = "zlib", version = "1.3.1.bcr.7")

# Bazel-enabled unitree_sdk2 fork (same pin as tmp/uni/bridge). Vendors
# cyclonedds 0.10.2 and prebuilt x86_64 + aarch64 libs.
bazel_dep(name = "unitree_sdk2")
git_override(
    module_name = "unitree_sdk2",
    commit = "8a05942d81669a74b374fc0d42cfdf2304ba2bdf",
    remote = "https://github.com/syaroshenko/unitree_sdk2.git",
)

# ONNX Runtime is not in the BCR; import the official release tarballs.
# 1.20.1 on both arches: 1.22.0's aarch64 build aborts at load time when a
# Jetson power profile has CPU cores offline.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "onnxruntime_linux_x64",
    build_file = "//:onnxruntime.BUILD",
    strip_prefix = "onnxruntime-linux-x64-1.20.1",
    urls = ["https://github.com/microsoft/onnxruntime/releases/download/v1.20.1/onnxruntime-linux-x64-1.20.1.tgz"],
)

http_archive(
    name = "onnxruntime_linux_aarch64",
    build_file = "//:onnxruntime.BUILD",
    strip_prefix = "onnxruntime-linux-aarch64-1.20.1",
    urls = ["https://github.com/microsoft/onnxruntime/releases/download/v1.20.1/onnxruntime-linux-aarch64-1.20.1.tgz"],
)
